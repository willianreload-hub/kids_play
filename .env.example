# Kids-Player Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials

# Supabase (painel: Settings -> API)
# Use a "Publishable key" (novo formato sb_publishable_...).
# O nome legado NEXT_PUBLIC_SUPABASE_ANON_KEY (eyJ...) continua funcionando como fallback.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
